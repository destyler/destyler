{
  "name": "@destyler/monorepo",
  "type": "module",
  "version": "0.3.2",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "author": "Elone Hoo <elonehoo@gmail.com>",
  "license": "MIT",
  "keywords": [
    "web component",
    "unstyle"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "core script": "Group: Core build tasks",
    "build": "pnpm run --filter \"./packages/**\" -r build && pnpm run docs:attr && pnpm run docs:type",
    "dev": "pnpm run --filter \"./packages/**\" -r watch",
    "clear script": "Group: Cleaning tasks",
    "clear:node_modules": "rm -rf ./node_modules && rm -rf pnpm-lock.yaml",
    "clear:packages:dist": "pnpm run --filter \"./packages/**\" -r clear ",
    "clear:packages:node_modules": "pnpm run --filter \"./packages/**\" -r clear:node_modules",
    "clear": "pnpm run clear:packages:dist && pnpm run clear:packages:node_modules && pnpm run clear:node_modules",
    "plop script": "Group: Code scaffolding",
    "generate-machine": "plop machine",
    "generate-example": "plop examples",
    "generate-shared": "plop shared",
    "lint code script": "Group: Quality & maintenance",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "taze": "taze",
    "test script": "Group: Testing",
    "test": "vitest run --browser.headless --coverage",
    "test:dev": "vitest dev --browser.headless",
    "test:ui": "vitest --ui --open",
    "test:deploy": "vitest run --reporter=html --browser.headless",
    "test:coverage": "vitest run --coverage",
    "check:declarations": "node scripts/check-public-declarations.mjs",
    "test:workflows": "node --test scripts/test/workflows.test.mjs scripts/test/browser-discovery.test.mjs scripts/test/zip.test.mjs scripts/test/consumer-runtime.test.mjs scripts/test/publish.test.mjs scripts/test/release-compatibility.test.mjs scripts/test/public-declarations.test.mjs",
    "test:types": "tsc --project tsconfig.type-tests.json && tsc --project packages/frameworks/vanilla/test/types/tsconfig.json && tsc --project packages/frameworks/vanilla/test/types/tsconfig.json --moduleResolution NodeNext --module NodeNext && tsc --project tsconfig.lit-types.json && tsc --project tsconfig.lit-types.nodenext.json && tsc --project packages/frameworks/vue/test/types/tsconfig.json && tsc --project packages/frameworks/vue/test/types/tsconfig.json --moduleResolution NodeNext --module NodeNext",
    "examples script": "Group: Example workspace filters",
    "vanilla": "pnpm --filter \"./examples/vanilla\"",
    "vue": "pnpm --filter \"./examples/vue\"",
    "react": "pnpm --filter \"./examples/react\"",
    "solid": "pnpm --filter \"./examples/solid\"",
    "svelte": "pnpm --filter \"./examples/svelte\"",
    "docs script": "Group: Documentation & API",
    "node-modules:dev": "cross-env DEVFRAME_DISABLE_INSTANCE_REGISTRY=1 DEVFRAME_INSTANCES_DIR=node_modules/.cache/node-modules-inspector/instances node-modules-inspector --host 127.0.0.1",
    "node-modules:build": "node-modules-inspector build",
    "visualize script": "Group: Dependency visualization",
    "docs:dev": "pnpm -C document run dev",
    "docs:build": "pnpm -C document run build",
    "docs:preview": "pnpm -C document run preview",
    "docs:attr": "tsx ./scripts/data-attr.ts",
    "docs:type": "tsx ./scripts/typedocs.ts",
    "storybook script": "Group: Storybook",
    "storybook:dev": "pnpm -C storybook run dev",
    "storybook:build": "pnpm -C storybook run build",
    "storybook:preview": "pnpm -C storybook run preview",
    "release script": "Group: Release",
    "release": "bumpp package.json packages/**/*/package.json --commit --push --tag",
    "publish:ci": "tsx ./scripts/publish.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@astrojs/react": "catalog:frontend",
    "@astrojs/solid-js": "catalog:frontend",
    "@astrojs/svelte": "catalog:frontend",
    "@astrojs/vue": "catalog:frontend",
    "@destyler/dom": "workspace:*",
    "@destyler/lit": "workspace:*",
    "@destyler/presence": "workspace:*",
    "@destyler/react": "workspace:*",
    "@destyler/shared-private": "workspace:*",
    "@destyler/solid": "workspace:*",
    "@destyler/stringify": "workspace:*",
    "@destyler/svelte": "workspace:*",
    "@destyler/tree": "workspace:*",
    "@destyler/vanilla": "workspace:*",
    "@destyler/vue": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:plugin",
    "@types/archiver": "catalog:types",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@typescript/native": "catalog:types",
    "@unocss/reset": "catalog:css",
    "@vitejs/plugin-react": "catalog:plugin",
    "@vitejs/plugin-vue": "catalog:plugin",
    "@vitest/browser": "catalog:test",
    "@vitest/browser-playwright": "catalog:test",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/eslint-plugin": "catalog:test",
    "@vitest/ui": "catalog:test",
    "archiver": "catalog:util",
    "astro": "catalog:frontend",
    "bumpp": "catalog:script",
    "cross-env": "catalog:util",
    "eslint": "catalog:lint",
    "fast-glob": "catalog:util",
    "find-packages": "catalog:util",
    "happy-dom": "catalog:test",
    "lit": "catalog:frontend",
    "nanoid": "catalog:util",
    "node-modules-inspector": "catalog:visual",
    "playwright": "catalog:test",
    "plop": "catalog:script",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "rimraf": "catalog:script",
    "rolldown": "catalog:build",
    "solid-js": "catalog:frontend",
    "svelte": "catalog:frontend",
    "taze": "catalog:script",
    "ts-morph": "catalog:types",
    "tsdown": "catalog:build",
    "tsx": "catalog:script",
    "typescript": "catalog:types",
    "unocss": "catalog:css",
    "vite": "catalog:build",
    "vite-plugin-solid": "catalog:plugin",
    "vitest": "catalog:test",
    "vitest-axe": "catalog:test",
    "vue": "catalog:frontend",
    "yaml": "catalog:test"
  }
}
