---
interface Props {
  title: string
  description: string
  link: string
  imgSrc: string
}

const { title, description, link, imgSrc } = Astro.props
---

<a href={link} class="decoration-none! hover:decoration-none! border-px rounded-md overflow-hidden flex border-border hover:border-primary">
  <div class="shadow-none flex flex-col overflow-hidden relative rounded-md bg-background">
    <!-- img -->
    <div class="build-image">
      <img src={imgSrc} alt={`${title} logo`} width="701" height="701">
    </div>
    <!-- body -->
    <div class="mt-0! flex-1 flex-col flex px-6 p-4">
      <h3 class="text-600 text-foreground text-4 my-0!">
        {title}
      </h3>
      <div class="text-sm text-foreground/60 my-0!">
        {description}
      </div>
    </div>
  </div>
</a>

<style>
  .build-image {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 13rem;
    padding: 1.5rem;
  }

  .build-image img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 10rem;
    max-height: 10rem;
    margin: 0;
    object-fit: contain;
  }

  :global([data-theme='dark']) .build-image img {
    filter: invert(1);
  }
</style>
